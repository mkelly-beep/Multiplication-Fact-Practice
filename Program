      Thursday: makeDayBlock([[3,4,12],[4,3,12],[3,6,18],[6,3,18],[3,7,21],[7,3,21],[3,8,24],[8,3,24]])
    }
  },
  {
    w: 2, t: "Anchor Fives", f: "5×3, 5×4, 5×6, 5×7, 5×8, 5×9",
    d: {
      Monday: makeDayBlock([[5,6,30],[6,5,30],[5,7,35],[7,5,35],[5,8,40],[8,5,40],[5,9,45],[9,5,45]]),
      Tuesday: makeDayBlock([[3,4,12],[4,3,12],[3,6,18],[6,3,18],[3,7,21],[7,3,21],[3,8,24],[8,3,24]]),
      Wednesday: makeDayBlock([[3,9,27],[9,3,27],[4,6,24],[6,4,24],[4,7,28],[7,4,28],[4,8,32],[8,4,32]]),
      Thursday: makeDayBlock([[4,9,36],[9,4,36],[6,7,42],[7,6,42],[6,8,48],[8,6,48],[6,9,54],[9,6,54]])
    }
  },
  {
    w: 3, t: "Tens, Ones & Zeros", f: "10×6, 10×7, 10×8, 1×8, 1×9, 0×8",
    d: {
      Monday: makeDayBlock([[3,9,27],[9,3,27],[4,6,24],[6,4,24],[4,7,28],[7,4,28],[4,8,32],[8,4,32]]),
      Tuesday: makeDayBlock([[4,9,36],[9,4,36],[6,7,42],[7,6,42],[6,8,48],[8,6,48],[6,9,54],[9,6,54]]),
      Wednesday: makeDayBlock([[7,8,56],[8,7,56],[7,9,63],[9,7,63],[8,9,72],[9,8,72],[6,6,36],[7,7,49]]),
      Thursday: makeDayBlock([[8,8,64],[9,9,81],[3,3,9],[4,4,16],[2,3,6],[3,2,6],[2,4,8],[4,2,8]])
    }
  },
  {
    w: 4, t: "Key Squares & Doubling Bridge", f: "3×3, 4×4, 6×6, 7×7, 8×8, 9×9",
    d: {
      Monday: makeDayBlock([[7,8,56],[8,7,56],[7,9,63],[9,7,63],[8,9,72],[9,8,72],[6,6,36],[7,7,49]]),
      Tuesday: makeDayBlock([[8,8,64],[9,9,81],[3,3,9],[4,4,16],[2,3,6],[3,2,6],[2,4,8],[4,2,8]]),
