<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>15-Week Multiplication & Magnitude Fluency</title>
<style>
  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --border: #e2e8f0;
    --text: #0f172a;
    --muted: #64748b;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --primary-soft: #eff6ff;
    --success: #16a34a;
    --success-soft: #dcfce7;
    --warning: #d97706;
    --warning-soft: #fef3c7;
    --danger: #dc2626;
    --danger-soft: #fee2e2;
    --locked: #cbd5e1;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.45;
  }
  header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 14px 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand h1 {
    font-size: 1.15rem;
    margin: 0;
    font-weight: 800;
  }
  .brand .sub {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .btn {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .btn:hover:not(:disabled) {
    background: #f1f5f9;
  }
  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .btn-primary {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }
  .btn-primary:hover:not(:disabled) {
    background: var(--primary-hover);
  }
  .btn-success {
    background: var(--success);
    color: #fff;
    border-color: var(--success);
  }
  .btn-success:hover:not(:disabled) {
    background: #15803d;
  }
  .btn-danger-outline {
    color: var(--danger);
    border-color: #fecaca;
    background: #fff;
  }
  .btn-danger-outline:hover:not(:disabled) {
    background: var(--danger-soft);
  }
  .container {
    max-width: 960px;
    margin: 0 auto;
    padding: 20px 16px 60px;
  }

  /* Summary Banner */
  .progress-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .stat-group {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }
  .stat-item .stat-val {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--primary);
  }
  .stat-item .stat-lbl {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .overall-bar-wrap {
    flex: 1;
    min-width: 220px;
  }
  .overall-bar-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .bar-track {
    height: 10px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    background: var(--success);
    border-radius: 999px;
    transition: width 0.3s ease;
  }

  /* Week Map */
  .weeks-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .week-card {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .week-card.current {
    border-color: var(--primary);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
  }
  .week-card.mastered {
    border-color: #86efac;
    background: #f0fdf4;
  }
  .week-card.locked {
    opacity: 0.72;
    background: #f8fafc;
  }
  .week-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }
  .week-title {
    font-weight: 800;
    font-size: 1rem;
  }
  .week-focus {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 2px;
  }
  .badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge-locked { background: #e2e8f0; color: #475569; }
  .badge-active { background: var(--primary-soft); color: var(--primary); }
  .badge-done { background: var(--success-soft); color: var(--success); }

  .tier-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tier-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-align: left;
  }
  .tier-row:hover:not(:disabled) {
    border-color: var(--primary);
    background: var(--primary-soft);
  }
  .tier-row:disabled {
    cursor: not-allowed;
    background: #f1f5f9;
    color: var(--muted);
  }
  .tier-row.done {
    border-color: #86efac;
    background: #dcfce7;
    color: #14532d;
  }

  .day-pills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 2px;
  }
  .day-pill {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    border-radius: 7px;
    padding: 5px 4px;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
  }
  .day-pill:hover:not(:disabled) {
    border-color: var(--primary);
    background: var(--primary-soft);
  }
  .day-pill:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .day-pill.done {
    background: var(--success-soft);
    border-color: #86efac;
    color: #14532d;
  }
  .day-pill.active-day {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* Practice View */
  .practice-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    max-width: 620px;
    margin: 0 auto;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
  }
  .practice-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .set-label {
    font-weight: 800;
    font-size: 1.05rem;
  }
  .set-sub {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .pip-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 6px;
    margin-bottom: 20px;
  }
  .pip {
    height: 10px;
    border-radius: 4px;
    background: #e2e8f0;
    transition: background 0.2s;
  }
  .pip.streak1 { background: #93c5fd; }
  .pip.mastered { background: var(--success); }
  .pip.current { outline: 2px solid var(--primary); outline-offset: 1px; }

  .flashcard-box {
    border: 2px solid var(--border);
    border-radius: 14px;
    padding: 28px 20px;
    text-align: center;
    background: #ffffff;
    margin-bottom: 18px;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .card-streak-tag {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .tag-new { background: #f1f5f9; color: #475569; }
  .tag-1 { background: var(--primary-soft); color: var(--primary); }
  .tag-2 { background: var(--success-soft); color: var(--success); }

  .problem-text {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 12px 0 20px;
  }
  .answer-form {
    display: flex;
    justify-content: center;
    gap: 10px;
    max-width: 340px;
    margin: 0 auto;
  }
  .answer-input {
    width: 160px;
    font-size: 1.6rem;
    font-weight: 800;
    text-align: center;
    padding: 10px 12px;
    border: 2px solid #cbd5e1;
    border-radius: 10px;
    outline: none;
  }
  .answer-input:focus {
    border-color: var(--primary);
  }
  .feedback-box {
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 10px;
    font-weight: 700;
    font-size: 1rem;
  }
  .fb-correct {
    background: var(--success-soft);
    color: #14532d;
    border: 1px solid #86efac;
  }
  .fb-wrong {
    background: var(--danger-soft);
    color: #7f1d1d;
    border: 1px solid #fecaca;
  }

  /* Modal / Fact Matrix */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 16px;
    z-index: 50;
  }
  .modal-backdrop.open {
    display: flex;
  }
  .modal {
    background: var(--surface);
    border-radius: 14px;
    max-width: 760px;
    width: 100%;
    max-height: 85vh;
    overflow-y: auto;
    padding: 20px 24px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }
  .modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 10px;
    gap: 10px;
    flex-wrap: wrap;
  }
  .fact-chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(125px, 1fr));
    gap: 8px;
    margin-top: 10px;
  }
  .fact-chip {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 6px 8px;
    font-size: 0.82rem;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    background: #f8fafc;
  }
  .fact-chip.m {
    background: var(--success-soft);
    border-color: #86efac;
    color: #14532d;
  }
  .fact-chip.p {
    background: var(--warning-soft);
    border-color: #fcd34d;
    color: #78350f;
  }
  .hidden { display: none !important; }
</style>
</head>
<body>

<header>
  <div class="brand">
    <div>
      <h1>15-Week Multiplication &amp; Magnitude Fluency</h1>
      <div class="sub" id="studentTag">Solo Mastery Mode • Small Daily Batches • Auto-Saved on This Browser</div>
    </div>
  </div>
  <div class="header-actions">
    <button class="btn" id="btnHome" onclick="showMap()">← All Weeks</button>
    <button class="btn" onclick="openMasteryModal()">📊 My Fact Log</button>
    <button class="btn" onclick="setStudentName()">👤 Name</button>
  </div>
</header>

<div class="container">
  <!-- Dashboard / Map View -->
  <div id="mapView">
    <div class="progress-card">
      <div class="stat-group">
        <div class="stat-item">
          <div class="stat-val" id="statSets">0 / 45</div>
          <div class="stat-lbl">Sets Mastered</div>
        </div>
        <div class="stat-item">
          <div class="stat-val" id="statFacts">0</div>
          <div class="stat-lbl">Unique Facts Mastered</div>
        </div>
      </div>
      <div class="overall-bar-wrap">
        <div class="overall-bar-top">
          <span>Overall Curriculum Mastery</span>
          <span id="statPct">0%</span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" id="overallFill" style="width: 0%"></div>
        </div>
      </div>
    </div>

    <div class="weeks-grid" id="weeksGrid"></div>
  </div>

  <!-- Active Practice View -->
  <div id="practiceView" class="hidden">
    <div class="practice-panel">
      <div class="practice-top">
        <div>
          <div class="set-label" id="pracTitle">Week 1 — Level 1: Core Facts (Monday)</div>
          <div class="set-sub" id="pracSub">Master all 8 cards in this day batch (2 correct in a row each)</div>
        </div>
        <div style="font-weight:800; font-size:0.9rem; color:var(--success);" id="pracCount">0 / 8 Mastered</div>
      </div>

      <div class="pip-grid" id="pipGrid"></div>

      <div id="cardStage">
        <div class="flashcard-box">
          <div class="card-meta">
            <span id="cardDayTag">Monday • Card #1</span>
            <span class="card-streak-tag tag-new" id="cardStreakTag">0 / 2 Streak</span>
          </div>
          <div class="problem-text" id="problemText">2 × 3</div>
          <form class="answer-form" onsubmit="handleSubmit(event)">
            <input type="text" inputmode="decimal" autocomplete="off" id="answerInput" class="answer-input" placeholder="?" aria-label="Answer">
            <button type="submit" class="btn btn-primary" id="submitBtn">Check</button>
          </form>
          <div id="feedbackArea" class="hidden"></div>
        </div>
      </div>

      <div id="completeStage" class="hidden" style="text-align:center; padding: 20px 10px;">
        <div style="font-size:2.4rem; margin-bottom:8px;">🎉</div>
        <h2 style="margin:0 0 8px;">Day Batch Mastered!</h2>
        <p style="color:var(--muted); margin:0 0 20px;" id="completeMsg">You mastered all 8 cards in this batch.</p>
        <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
          <button class="btn btn-success" id="btnNextSet" onclick="startNextBatch()">Next Day Batch →</button>
          <button class="btn" onclick="showMap()">Back to All Weeks</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Fact Log Modal -->
<div class="modal-backdrop" id="masteryModal" onclick="if(event.target===this) closeMasteryModal()">
  <div class="modal">
    <div class="modal-head">
      <div>
        <strong style="font-size:1.1rem;" id="modalTitle">Student Fact Mastery Log</strong>
        <div style="font-size:0.82rem; color:var(--muted);">Green = Mastered (2+ streak) • Yellow = In Progress</div>
      </div>
      <div style="display:flex; gap:8px;">
        <button class="btn btn-danger-outline" onclick="resetAllProgress()">Reset Progress</button>
        <button class="btn" onclick="closeMasteryModal()">Close</button>
      </div>
    </div>
    <div id="modalBody"></div>
  </div>
</div>

<script>
const DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday"];
const LEVELS = ["L1", "L2", "L3"];
const LEVEL_NAMES = {
  L1: "Level 1: Core Facts",
  L2: "Level 2: Tens Scaling",
  L3: "Level 3: Decimal & Tens Scaling"
};

function makeDayBlock(pairs) {
  const l1 = pairs.map(([a, b, ans]) => [`${a} × ${b}`, String(ans)]);
  const l2 = pairs.map(([a, b, ans]) => [`${a * 10} × ${b}`, String(ans * 10)]);
  const l3 = pairs.map(([a, b, ans]) => [`0.${a} × ${b * 10}`, String(ans)]);
  return { L1: l1, L2: l2, L3: l3 };
}

const DATA = [
  {
    w: 1, t: "Anchor Twos", f: "2×3, 2×4, 2×6, 2×7, 2×8, 2×9",
    d: {
