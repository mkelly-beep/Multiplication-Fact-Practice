const STORAGE_KEY = "fluency15_batch_v1";

function defaultState() {
  return {
    studentName: "",
    factStreaks: {},      // problem -> streak count
    completedBatches: {} // "w1-L1-Monday" -> true
  };
}

let state = loadState();
let activeSession = null; // { weekIdx, level, day, cards: [{q, a, streak}], idx, awaitingNext }

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return defaultState();
    const parsed = JSON.parse(raw);
    return {
      studentName: parsed.studentName || "",
      factStreaks: parsed.factStreaks || {},
      completedBatches: parsed.completedBatches || {}
    };
  } catch {
    return defaultState();
  }
}

function saveState() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function setStudentName() {
  const name = prompt("Enter student name (or leave blank):", state.studentName || "");
  if (name === null) return;
  state.studentName = name.trim();
  saveState();
  updateHeaderTag();
}

function updateHeaderTag() {
  const el = document.getElementById("studentTag");
  const prefix = state.studentName ? `${state.studentName} • ` : "Solo Mastery Mode • ";
  el.textContent = `${prefix}Small Daily Batches (8 Cards) • Auto-Saved on This Browser`;
}

function getAllPossibleFacts() {
  const map = new Map();
  DATA.forEach(w => {
    DAYS.forEach(day => {
      LEVELS.forEach(lvl => {
        (w.d[day][lvl] || []).forEach(([q, a]) => {
          if (!map.has(q)) map.set(q, a);
        });
      });
    });
  });
  return map;
}

function getBatchKey(weekNum, level, day) {
  return `w${weekNum}-${level}-${day}`;
}

function isBatchDone(weekNum, level, day) {
  return Boolean(state.completedBatches[getBatchKey(weekNum, level, day)]);
}

function getLevelDoneCount(weekObj, level) {
  return DAYS.filter(day => isBatchDone(weekObj.w, level, day)).length;
}

function isLevelDone(weekObj, level) {
  return getLevelDoneCount(weekObj, level) === DAYS.length;
}

function isWeekDone(weekObj) {
  return LEVELS.every(lvl => isLevelDone(weekObj, lvl));
}

function isWeekUnlocked(weekIdx) {
  if (weekIdx === 0) return true;
  return isWeekDone(DATA[weekIdx - 1]);
}

function isLevelUnlocked(weekIdx, levelIdx) {
  if (!isWeekUnlocked(weekIdx)) return false;
  if (levelIdx === 0) return true;
  return isLevelDone(DATA[weekIdx], LEVELS[levelIdx - 1]);
}

function isDayUnlocked(weekIdx, levelIdx, dayIdx) {
  if (!isLevelUnlocked(weekIdx, levelIdx)) return false;
  if (dayIdx === 0) return true;
  return isBatchDone(DATA[weekIdx].w, LEVELS[levelIdx], DAYS[dayIdx - 1]);
}

function getTotalCompletedSets() {
  let count = 0;
  DATA.forEach(w => {
    DAYS.forEach(day => {
      LEVELS.forEach(lvl => {
        if (isBatchDone(w.w, lvl, day)) count++;
      });
    });
  });
  return count;
}

function getTotalPossibleSets() {
  return DATA.length * DAYS.length * LEVELS.length; // 15 * 4 * 3 = 180 day batches
}

function renderSummary() {
  const totalSets = getTotalPossibleSets();
  const doneSets = getTotalCompletedSets();
  const allFacts = getAllPossibleFacts();
  let masteredFacts = 0;
  allFacts.forEach((_, q) => {
    if ((state.factStreaks[q] || 0) >= 2) masteredFacts++;
  });

  const pct = totalSets ? Math.round((doneSets / totalSets) * 100) : 0;
  document.getElementById("statSets").textContent = `${doneSets} / ${totalSets}`;
  document.getElementById("statFacts").textContent = `${masteredFacts} / ${allFacts.size}`;
  document.getElementById("statPct").textContent = `${pct}%`;
  document.getElementById("overallFill").style.width = `${pct}%`;
}

function renderMap() {
  renderSummary();
  const grid = document.getElementById("weeksGrid");
  grid.innerHTML = "";

  let foundCurrent = false;

  DATA.forEach((weekObj, wIdx) => {
    const unlocked = isWeekUnlocked(wIdx);
    const done = isWeekDone(weekObj);
    let isCurrent = false;
    if (unlocked && !done && !foundCurrent) {
      isCurrent = true;
      foundCurrent = true;
    }

    const card = document.createElement("div");
    card.className = `week-card ${done ? "mastered" : isCurrent ? "current" : !unlocked ? "locked" : ""}`;

    let badgeHtml = `<span class="badge badge-locked">Locked</span>`;
    if (done) badgeHtml = `<span class="badge badge-done">Mastered</span>`;
    else if (unlocked) badgeHtml = `<span class="badge badge-active">Open</span>`;

    const tiersHtml = LEVELS.map((lvl, lIdx) => {
      const lvlUnlocked = isLevelUnlocked(wIdx, lIdx);
      const lvlDone = isLevelDone(weekObj, lvl);
      const doneDays = getLevelDoneCount(weekObj, lvl);

      // Pick first incomplete unlocked day in this level, or Monday if done
      const targetDayIdx = (() => {
        for (let d = 0; d < DAYS.length; d++) {
          if (isDayUnlocked(wIdx, lIdx, d) && !isBatchDone(weekObj.w, lvl, DAYS[d])) {
            return d;
          }
        }
        return 0;
      })();

      const dayButtonsHtml = DAYS.map((dayName, dIdx) => {
        const dDone = isBatchDone(weekObj.w, lvl, dayName);
        const dUnlocked = isDayUnlocked(wIdx, lIdx, dIdx);
        const isNext = dUnlocked && !dDone && dIdx === targetDayIdx;
        return `<button class="day-pill ${dDone ? "done" : ""} ${isNext ? "active-day" : ""}"
          ${!dUnlocked ? "disabled" : ""}
          onclick="startBatch(${wIdx}, '${lvl}', '${dayName}')">${dayName.slice(0, 3)}</button>`;
      }).join("");

      return `
        <div>
          <button class="tier-row ${lvlDone ? "done" : ""}"
            ${!lvlUnlocked ? "disabled" : ""}
            onclick="startBatch(${wIdx}, '${lvl}', '${DAYS[targetDayIdx]}')">
            <span>${LEVEL_NAMES[lvl]}</span>
            <span>${lvlDone ? "✓ 4/4 Days" : `${doneDays}/4 Days`}</span>
          </button>
          <div class="day-pills">${dayButtonsHtml}</div>
        </div>
      `;
    }).join("");

    card.innerHTML = `
      <div>
        <div class="week-head">
          <div>
            <div class="week-title">Week ${weekObj.w}: ${weekObj.t}</div>
            <div class="week-focus">${weekObj.f}</div>
          </div>
          ${badgeHtml}
        </div>
      </div>
      <div class="tier-list">${tiersHtml}</div>
    `;

    grid.appendChild(card);
  });
}

function showMap() {
  activeSession = null;
  document.getElementById("practiceView").classList.add("hidden");
  document.getElementById("mapView").classList.remove("hidden");
  renderMap();
}

function startBatch(weekIdx, level, day) {
  const weekObj = DATA[weekIdx];
  if (!weekObj || !weekObj.d[day] || !weekObj.d[day][level]) return;

  const rawPairs = weekObj.d[day][level];
  const cards = rawPairs.map(([q, a]) => ({
    q,
    a,
    streak: (state.factStreaks[q] || 0) >= 2 ? 2 : 0
  }));

  activeSession = {
    weekIdx,
    level,
    day,
    cards,
    idx: 0,
    awaitingNext: false
  };

  document.getElementById("mapView").classList.add("hidden");
  document.getElementById("practiceView").classList.remove("hidden");
  document.getElementById("cardStage").classList.remove("hidden");
  document.getElementById("completeStage").classList.add("hidden");

  document.getElementById("pracTitle").textContent =
    `Week ${weekObj.w} — ${LEVEL_NAMES[level]} (${day})`;
  document.getElementById("pracSub").textContent =
    `Small batch: master all ${cards.length} cards (2 correct in a row each)`;

  renderPracticeCard();
}

function pickNextCardIndex() {
  if (!activeSession) return 0;
  const unmastered = [];
  activeSession.cards.forEach((c, i) => {
    if (c.streak < 2) unmastered.push(i);
  });
  if (unmastered.length === 0) return -1;

  // Prefer an unmastered card different from current if multiple remain
  const candidates = unmastered.length > 1
    ? unmastered.filter(i => i !== activeSession.idx)
    : unmastered;
  return candidates[Math.floor(Math.random() * candidates.length)];
}

function renderPracticeCard() {
  if (!activeSession) return;
  const { cards, day } = activeSession;
  const masteredCount = cards.filter(c => c.streak >= 2).length;
  document.getElementById("pracCount").textContent = `${masteredCount} / ${cards.length} Mastered`;

  const pipGrid = document.getElementById("pipGrid");
  pipGrid.innerHTML = "";
  cards.forEach((c, i) => {
    const pip = document.createElement("div");
    let cls = "pip";
    if (c.streak >= 2) cls += " mastered";
    else if (c.streak === 1) cls += " streak1";
    if (i === activeSession.idx && masteredCount < cards.length) cls += " current";
    pip.className = cls;
    pipGrid.appendChild(pip);
  });

  if (masteredCount >= cards.length) {
    finishBatch();
    return;
  }

  const card = cards[activeSession.idx];
  document.getElementById("cardDayTag").textContent = `${day} • Card #${activeSession.idx + 1} of ${cards.length}`;

  const tag = document.getElementById("cardStreakTag");
  if (card.streak === 0) {
    tag.className = "card-streak-tag tag-new";
    tag.textContent = "0 / 2 Streak";
  } else if (card.streak === 1) {
    tag.className = "card-streak-tag tag-1";
    tag.textContent = "1 / 2 Streak";
  } else {
    tag.className = "card-streak-tag tag-2";
    tag.textContent = "2 / 2 Mastered";
  }

  document.getElementById("problemText").textContent = card.q;

  const input = document.getElementById("answerInput");
  input.value = "";
  input.disabled = false;
  document.getElementById("submitBtn").disabled = false;

  const fb = document.getElementById("feedbackArea");
  fb.className = "hidden";
  fb.innerHTML = "";

  activeSession.awaitingNext = false;
  setTimeout(() => input.focus(), 20);
}

function normalizeNum(val) {
  const trimmed = String(val || "").trim();
  if (trimmed === "") return null;
  const num = Number(trimmed);
  return Number.isFinite(num) ? num : null;
}

function handleSubmit(e) {
  e.preventDefault();
  if (!activeSession) return;

  if (activeSession.awaitingNext) {
    activeSession.idx = pickNextCardIndex();
    renderPracticeCard();
    return;
  }

  const input = document.getElementById("answerInput");
  const userVal = normalizeNum(input.value);
  if (userVal === null) {
    input.focus();
    return;
  }

  const card = activeSession.cards[activeSession.idx];
  const expectedVal = Number(card.a);
  const isCorrect = Math.abs(userVal - expectedVal) < 1e-9;

  const fb = document.getElementById("feedbackArea");
  fb.classList.remove("hidden");

  if (isCorrect) {
    card.streak = Math.min(2, card.streak + 1);
    const prevGlobal = state.factStreaks[card.q] || 0;
    state.factStreaks[card.q] = Math.max(prevGlobal + 1, card.streak);
    saveState();

    fb.className = "feedback-box fb-correct";
    fb.innerHTML = card.streak >= 2
      ? `✓ Spot on! (${card.q} = ${card.a}) — Card mastered!`
      : `✓ Correct! (${card.q} = ${card.a}) — 1 more in a row to master this card.`;
  } else {
    card.streak = 0;
    state.factStreaks[card.q] = 0;
    saveState();

    fb.className = "feedback-box fb-wrong";
    fb.innerHTML = `Not quite — <strong>${card.q} = ${card.a}</strong>. Streak reset to 0 so you'll see it again soon.`;
  }

  input.disabled = true;
  document.getElementById("submitBtn").disabled = true;
  activeSession.awaitingNext = true;

  setTimeout(() => {
    if (!activeSession || !activeSession.awaitingNext) return;
    activeSession.idx = pickNextCardIndex();
    renderPracticeCard();
  }, isCorrect ? 850 : 1550);
}

function finishBatch() {
  const { weekIdx, level, day, cards } = activeSession;
  const weekObj = DATA[weekIdx];
  const key = getBatchKey(weekObj.w, level, day);
  state.completedBatches[key] = true;
  saveState();

  document.getElementById("cardStage").classList.add("hidden");
  document.getElementById("completeStage").classList.remove("hidden");
  document.getElementById("completeMsg").textContent =
    `You mastered all ${cards.length} cards in Week ${weekObj.w} • ${LEVEL_NAMES[level]} (${day}).`;

  const nextInfo = findNextBatchInfo();
  const btnNext = document.getElementById("btnNextSet");
  if (nextInfo) {
    btnNext.classList.remove("hidden");
    btnNext.textContent = `Next: W${DATA[nextInfo.weekIdx].w} ${nextInfo.level} (${nextInfo.day}) →`;
  } else {
    btnNext.classList.add("hidden");
  }
}

function findNextBatchInfo() {
  for (let w = 0; w < DATA.length; w++) {
    for (let l = 0; l < LEVELS.length; l++) {
      for (let d = 0; d < DAYS.length; d++) {
        const lvl = LEVELS[l];
        const day = DAYS[d];
        if (isDayUnlocked(w, l, d) && !isBatchDone(DATA[w].w, lvl, day)) {
          return { weekIdx: w, level: lvl, day };
        }
      }
    }
  }
  return null;
}

function startNextBatch() {
  const nextInfo = findNextBatchInfo();
  if (!nextInfo) {
    showMap();
    return;
  }
  startBatch(nextInfo.weekIdx, nextInfo.level, nextInfo.day);
}

function openMasteryModal() {
  const modal = document.getElementById("masteryModal");
  const body = document.getElementById("modalBody");
  const allFacts = getAllPossibleFacts();

  let mastered = 0;
  let inProg = 0;
  const chips = [];

  allFacts.forEach((ans, q) => {
    const s = state.factStreaks[q] || 0;
    let cls = "fact-chip";
    let status = "New";
    if (s >= 2) {
      cls += " m";
      status = `${s}★`;
      mastered++;
    } else if (s === 1) {
      cls += " p";
      status = "1/2";
      inProg++;
    }
    chips.push(`<div class="${cls}"><span>${q} = ${ans}</span><span>${status}</span></div>`);
  });

  document.getElementById("modalTitle").textContent =
    `Student Fact Mastery Log (${mastered} Mastered • ${inProg} In Progress)`;
  body.innerHTML = `<div class="fact-chips">${chips.join("")}</div>`;
  modal.classList.add("open");
}

function closeMasteryModal() {
  document.getElementById("masteryModal").classList.remove("open");
}

function resetAllProgress() {
  if (!confirm("Reset all saved mastery progress and completed day batches on this browser?")) return;
  state = defaultState();
  saveState();
  updateHeaderTag();
  closeMasteryModal();
  showMap();
}

updateHeaderTag();
renderMap();
