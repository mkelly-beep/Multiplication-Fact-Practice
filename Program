    }
  },
  {
    w: 6, t: "Triple-Doubles: Eights", f: "8×3, 8×4, 8×6, 8×7, 8×9",
    d: {
      Monday: makeDayBlock([[5,8,40],[8,5,40],[5,9,45],[9,5,45],[3,4,12],[4,3,12],[3,6,18],[6,3,18]]),
      Tuesday: makeDayBlock([[3,7,21],[7,3,21],[3,8,24],[8,3,24],[3,9,27],[9,3,27],[4,6,24],[6,4,24]]),
