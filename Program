    }
  },
  {
    w: 7, t: "Threes", f: "3×4, 3×6, 3×7, 3×8, 3×9",
    d: {
      Monday: makeDayBlock([[4,7,28],[7,4,28],[4,8,32],[8,4,32],[4,9,36],[9,4,36],[6,7,42],[7,6,42]]),
      Tuesday: makeDayBlock([[6,8,48],[8,6,48],[6,9,54],[9,6,54],[7,8,56],[8,7,56],[7,9,63],[9,7,63]]),
      Wednesday: makeDayBlock([[8,9,72],[9,8,72],[6,6,36],[7,7,49],[8,8,64],[9,9,81],[3,3,9],[4,4,16]]),
      Thursday: makeDayBlock([[2,3,6],[3,2,6],[2,4,8],[4,2,8],[2,6,12],[6,2,12],[2,7,14],[7,2,14]])
    }
  },
  {
